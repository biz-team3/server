# 공통 서버 설정
SERVER_PORT=8080

# JWT Secret Key
JWT_SECRET=your-secret-key

# Oracle DB
# Copy this file to .env and fill in the Oracle connection shared by the team.
DB_URL=jdbc:oracle:thin:@//<HOST>:1521/<SERVICE_NAME>
DB_USERNAME=<USERNAME>
DB_PASSWORD=<PASSWORD>

DB_URL_LOCAL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USERNAME_LOCAL=biz_team3
DB_PASSWORD=biz_team3

# Production profile tuning
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
