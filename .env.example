# 공통 서버 설정
SERVER_PORT=8080

# Oracle DB
# macOS/Linux Docker Oracle Free 예시:
# DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
#
# Windows Oracle XE 예시:
# DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USERNAME=biz_team3
DB_PASSWORD=biz_team3

# Production profile tuning
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
