-- COMMENTS
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (1, 1, 2, '발표 흐름 보여주기 딱 좋은 첫 게시물이에요. 캐러셀까지 있어서 자연스럽습니다.', SYSTIMESTAMP - INTERVAL '11' MINUTE, SYSTIMESTAMP - INTERVAL '11' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (2, 1, 3, '이미지 두 장 넘길 때 버튼 위치가 안정적으로 보이면 좋겠어요.', SYSTIMESTAMP - INTERVAL '10' MINUTE, SYSTIMESTAMP - INTERVAL '10' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (3, 1, 4, '댓글이 많아도 모달에서 스크롤이 자연스러운지 확인하기 좋네요.', SYSTIMESTAMP - INTERVAL '9' MINUTE, SYSTIMESTAMP - INTERVAL '9' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (4, 1, 5, '저장 버튼 상태까지 바로 확인되는 게 좋아요.', SYSTIMESTAMP - INTERVAL '8' MINUTE, SYSTIMESTAMP - INTERVAL '8' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (5, 1, 8, '프로필 이미지가 다르게 보여서 더 실제 계정처럼 느껴집니다.', SYSTIMESTAMP - INTERVAL '7' MINUTE, SYSTIMESTAMP - INTERVAL '7' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (6, 1, 1, '내 댓글 수정과 삭제 테스트용으로 남겨둔 코멘트입니다.', SYSTIMESTAMP - INTERVAL '6' MINUTE, SYSTIMESTAMP - INTERVAL '6' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (7, 1, 18, '무료 체험 안내는 클릭하세요. 이 댓글은 숨겨진 단어 모드에서 접히는지 보여주는 안전한 예시입니다.', SYSTIMESTAMP - INTERVAL '5' MINUTE, SYSTIMESTAMP - INTERVAL '5' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (8, 1, 9, '사진 톤이 발표 화면에서도 잘 보일 것 같아요.', SYSTIMESTAMP - INTERVAL '4' MINUTE, SYSTIMESTAMP - INTERVAL '4' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (9, 1, 10, '시간 표시가 최근 글처럼 나와서 시연하기 좋네요.', SYSTIMESTAMP - INTERVAL '3' MINUTE, SYSTIMESTAMP - INTERVAL '3' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (10, 1, 12, '좋아요와 댓글 수가 적당히 있어서 빈 화면 느낌이 없습니다.', SYSTIMESTAMP - INTERVAL '2' MINUTE, SYSTIMESTAMP - INTERVAL '2' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (11, 1, 14, '알림 패널에서도 이 게시물 관련 이벤트가 보이면 흐름이 이어지겠어요.', SYSTIMESTAMP - INTERVAL '1' MINUTE, SYSTIMESTAMP - INTERVAL '1' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (12, 3, 2, '설정을 켜면 이 캡션이 접히는지 바로 확인할 수 있겠네요.', SYSTIMESTAMP - INTERVAL '50' MINUTE, SYSTIMESTAMP - INTERVAL '50' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (13, 3, 15, 'click here 문구도 기본 숨김 단어에 들어가 있어서 댓글 데모에 쓸 수 있습니다.', SYSTIMESTAMP - INTERVAL '49' MINUTE, SYSTIMESTAMP - INTERVAL '49' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (14, 5, 1, '이 브런치 사진 저장해뒀어요. 발표 끝나면 진짜 먹으러 가고 싶네요.', SYSTIMESTAMP - INTERVAL '3' HOUR, SYSTIMESTAMP - INTERVAL '3' HOUR, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (15, 6, 1, '골목 사진이 홈 피드에 섞이니까 더 실제 서비스 같아요.', SYSTIMESTAMP - INTERVAL '4' HOUR, SYSTIMESTAMP - INTERVAL '4' HOUR, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (16, 7, 2, '창가 자리 사진 분위기 좋아요.', SYSTIMESTAMP - INTERVAL '5' HOUR, SYSTIMESTAMP - INTERVAL '5' HOUR, NULL);
