-- POSTS
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (1, 1, 'Aigram 발표 전 마지막 점검. 홈 피드, 프로필, 스토리, 알림 흐름이 한 화면에서 자연스럽게 이어지는지 확인 중입니다. #개발 #Aigram #시연 #자바 #React', 'Final check before the Aigram demo.', SYSTIMESTAMP - INTERVAL '1' HOUR - INTERVAL '37' MINUTE, SYSTIMESTAMP - INTERVAL '53' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (2, 1, '오늘은 카페에서 API 응답과 피드 스크롤 체감을 같이 봤다. 작은 버그를 잡는 시간이 제일 길지만 그만큼 결과가 안정적이다. #개발 #Aigram #시연 #팔로우', 'Checked API responses and feed scrolling at a cafe.', SYSTIMESTAMP - INTERVAL '2' HOUR - INTERVAL '14' MINUTE, SYSTIMESTAMP - INTERVAL '1' HOUR - INTERVAL '16' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (3, 1, '숨겨진 단어 모드 테스트용 게시글. 무료 체험 문구와 클릭하세요, 바로가기 같은 마케팅 표현이 접히는지 확인합니다. #무료체험 #clickhere #바로가기', 'Hidden word mode test post.', SYSTIMESTAMP - INTERVAL '2' HOUR - INTERVAL '51' MINUTE, SYSTIMESTAMP - INTERVAL '1' HOUR - INTERVAL '39' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (4, 1, '프로필 화면에서 팔로워와 팔로잉 수가 실제 계정처럼 보이는지 확인. 발표자가 설명할 수 있는 숫자가 중요하다. #개발 #Aigram #시연 #MyBatis #저장 #댓글 #자바 #스프링 #KOSA #코드리뷰', 'Profile count verification.', SYSTIMESTAMP - INTERVAL '3' HOUR - INTERVAL '28' MINUTE, SYSTIMESTAMP - INTERVAL '2' HOUR - INTERVAL '2' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (5, 1, '댓글 알림과 좋아요 알림을 함께 받았을 때 실제 SNS처럼 느껴지는지 테스트하는 중. #개발 #Aigram #시연 #배포준비 #React #시드데이터 #포트폴리오 #일상 #피드', 'Testing comment and like notifications together.', SYSTIMESTAMP - INTERVAL '4' HOUR - INTERVAL '5' MINUTE, SYSTIMESTAMP - INTERVAL '2' HOUR - INTERVAL '25' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (6, 1, '주말에는 디자인 레퍼런스를 정리했다. 너무 화려한 화면보다 손에 익은 앱 같은 자연스러움이 더 어렵다. #개발 #Aigram #시연 #배포준비 #전시 #프로필 #피드 #자바', 'Organized design references over the weekend.', SYSTIMESTAMP - INTERVAL '4' HOUR - INTERVAL '42' MINUTE, SYSTIMESTAMP - INTERVAL '2' HOUR - INTERVAL '48' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (7, 1, '로컬 DB seed를 다시 손보는 날. 빈 계정이 아니라 살아있는 네트워크처럼 보여야 시연이 편하다. #개발 #Aigram #시연 #모바일UX #발표 #자바 #피드', 'Reworking local DB seed data.', SYSTIMESTAMP - INTERVAL '5' HOUR - INTERVAL '19' MINUTE, SYSTIMESTAMP - INTERVAL '3' HOUR - INTERVAL '11' MINUTE, NULL);
