-- Demo seed data for the Instagram-style presentation flow.
-- Run after the table DDL files in src/main/resources/db have been applied.
-- The schema is unchanged; this file only resets and inserts richer demo data.

-- RESET EXISTING DEMO DATA
DELETE FROM story_views;
DELETE FROM post_read_logs;
DELETE FROM notifications;
DELETE FROM comments;
DELETE FROM saves;
DELETE FROM likes;
DELETE FROM post_hashtags;
DELETE FROM medias;
DELETE FROM stories;
DELETE FROM follow_requests;
DELETE FROM follows;
DELETE FROM token_blacklist;
DELETE FROM hashtags;
DELETE FROM posts;
DELETE FROM users;
COMMIT;

