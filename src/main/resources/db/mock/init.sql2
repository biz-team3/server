-- POSTS
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (1, 1, '오늘 피드 시연 전 최종 점검. 이미지 캐러셀, 댓글, 저장 상태가 한 화면에서 자연스럽게 보여야 한다. #개발 #시연 #Aigram', 'Final presentation check for carousel, comments, and saved state in one feed card.', SYSTIMESTAMP - INTERVAL '12' MINUTE, SYSTIMESTAMP - INTERVAL '12' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (2, 1, '점심 산책 중 발견한 빛. 잠깐 나갔다 왔는데 오늘 UI 톤도 이렇게 차분했으면 좋겠다. #일상 #사진', 'A quiet lunch walk and a calm visual note for the UI.', SYSTIMESTAMP - INTERVAL '48' MINUTE, SYSTIMESTAMP - INTERVAL '48' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (3, 1, '숨겨진 단어 테스트용: 무료 체험 문구가 들어간 캡션입니다. 발표 때 설정을 켜면 이 문장이 접혀야 합니다. #HiddenWords #시연', 'Hidden words demo caption with a safe spam phrase.', SYSTIMESTAMP - INTERVAL '1' HOUR, SYSTIMESTAMP - INTERVAL '1' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (4, 1, '어제 만든 프로필 화면 기록. 내 게시물 수정과 삭제 메뉴가 로그인 사용자에게만 보이는지 확인하기 좋다. #개발 #작업로그', 'Profile screen note for owner-only edit and delete controls.', SYSTIMESTAMP - INTERVAL '3' HOUR, SYSTIMESTAMP - INTERVAL '3' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (5, 2, '주말 아침 브런치. 친구들이랑 오래 이야기한 날은 사진 색도 조금 따뜻하게 남는다. #브런치 #일상', 'Weekend brunch with warm colors and long conversations.', SYSTIMESTAMP - INTERVAL '4' HOUR, SYSTIMESTAMP - INTERVAL '4' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (6, 3, '을지로 골목 끝에서 만난 오후의 빛. 오래된 간판과 새 가게가 같이 있는 풍경이 좋다. #서울 #사진', 'Afternoon light in an Euljiro alley.', SYSTIMESTAMP - INTERVAL '5' HOUR, SYSTIMESTAMP - INTERVAL '5' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (7, 4, '비 오는 오후에는 진한 라떼와 작은 디저트. 창가 자리가 오늘의 최고 선택. #카페 #일상', 'A rainy cafe afternoon with latte and dessert.', SYSTIMESTAMP - INTERVAL '6' HOUR, SYSTIMESTAMP - INTERVAL '6' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (8, 5, '퇴근 후 5km. 기록보다 중요한 건 오늘도 밖으로 나갔다는 사실. #러닝 #기록', 'A steady five kilometer run after work.', SYSTIMESTAMP - INTERVAL '7' HOUR, SYSTIMESTAMP - INTERVAL '7' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (9, 6, '새 브랜드 시안 회의. 같은 색도 화면과 종이에서 완전히 다르게 보인다. #디자인 #작업로그', 'Brand draft review with color checks across screen and paper.', SYSTIMESTAMP - INTERVAL '8' HOUR, SYSTIMESTAMP - INTERVAL '8' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (10, 7, '빈티지 팝업 준비 완료. 오래된 물건이 새 주인을 만나는 순간을 좋아한다. #빈티지 #일상', 'Vintage pop-up prep and objects ready for a new home.', SYSTIMESTAMP - INTERVAL '9' HOUR, SYSTIMESTAMP - INTERVAL '9' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (11, 8, '밤에 읽기 좋은 문장 하나. 속도를 낮추면 보이는 것들이 있다. #책 #기록', 'A sentence for a slow reading night.', SYSTIMESTAMP - INTERVAL '10' HOUR, SYSTIMESTAMP - INTERVAL '10' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (12, 9, '성수동 라멘 한 그릇. 국물 온도와 면 식감이 딱 좋았던 저녁. #맛집 #일상', 'A satisfying ramen dinner in Seongsu.', SYSTIMESTAMP - INTERVAL '11' HOUR, SYSTIMESTAMP - INTERVAL '11' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (13, 10, '강릉 바다 앞에서 잠깐 멈춤. 여행은 멀리 가는 일보다 천천히 보는 일에 가깝다. #여행 #사진', 'A quiet pause by the Gangneung sea.', SYSTIMESTAMP - INTERVAL '12' HOUR, SYSTIMESTAMP - INTERVAL '12' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (14, 11, '새로 데려온 몬스테라. 잎이 펴지는 속도에 맞춰 방도 조금씩 정리 중. #식물 #일상', 'A new monstera and a slowly cleaned room.', SYSTIMESTAMP - INTERVAL '13' HOUR, SYSTIMESTAMP - INTERVAL '13' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (15, 12, '리팩터링 전 체크리스트. 작은 단위로 나누면 마음이 덜 급해진다. #개발 #DevLife #작업로그', 'A refactoring checklist split into small steps.', SYSTIMESTAMP - INTERVAL '14' HOUR, SYSTIMESTAMP - INTERVAL '14' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (16, 13, '아침 요가 20분. 몸이 먼저 차분해지면 하루도 조금 부드럽게 시작된다. #요가 #일상', 'A gentle twenty minute morning yoga session.', SYSTIMESTAMP - INTERVAL '15' HOUR, SYSTIMESTAMP - INTERVAL '15' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (17, 14, '포스터 인쇄 감리. 모니터에서 예뻤던 파란색을 종이에 맞추는 일이 제일 어렵다. #포스터 #디자인', 'Print proofing a poster and adjusting the blues.', SYSTIMESTAMP - INTERVAL '16' HOUR, SYSTIMESTAMP - INTERVAL '16' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (18, 15, '주말 원데이 클래스 무료 체험 오픈! 관심 있는 분들은 클릭하세요. 발표용 숨겨진 단어 데모에 쓰기 좋은 안전한 홍보 문구입니다. #클래스 #무료체험', 'Safe promotional copy for the hidden words demo.', SYSTIMESTAMP - INTERVAL '17' HOUR, SYSTIMESTAMP - INTERVAL '17' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (19, 16, 'New creator toolkit free trial is live. limited offer, sign up now. This is demo-safe spam text for Hidden Words mode. #creator #event', 'English spam-style copy for hidden words demonstration.', SYSTIMESTAMP - INTERVAL '18' HOUR, SYSTIMESTAMP - INTERVAL '18' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (20, 17, '필름 카메라 테스트 롤. 초점이 살짝 빗나간 사진까지 마음에 드는 날이 있다. #필름 #사진', 'A film camera test roll with imperfect focus.', SYSTIMESTAMP - INTERVAL '19' HOUR, SYSTIMESTAMP - INTERVAL '19' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (21, 18, '동네 소식 모음. 선착순 증정 이벤트와 바로가기 링크는 프로필에서 확인하세요. 발표용 숨김 처리 확인 게시글입니다. #공지 #이벤트', 'Local notice with safe promotional terms for hiding.', SYSTIMESTAMP - INTERVAL '20' HOUR, SYSTIMESTAMP - INTERVAL '20' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (22, 2, '친구들이랑 망원 한강. 돗자리 하나로도 충분했던 저녁. #한강 #일상', 'An evening picnic by the Han River.', SYSTIMESTAMP - INTERVAL '1' DAY, SYSTIMESTAMP - INTERVAL '1' DAY, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (23, 3, '서울숲 해질녘. 같은 길도 시간대가 바뀌면 전혀 다른 장소처럼 보인다. #서울 #사진', 'Sunset in Seoul Forest.', SYSTIMESTAMP - INTERVAL '26' HOUR, SYSTIMESTAMP - INTERVAL '26' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (24, 4, '작은 로스터리에서 오늘의 원두를 골랐다. 산미가 가벼워서 오후에 잘 어울린다. #카페 #기록', 'Choosing beans at a small roastery.', SYSTIMESTAMP - INTERVAL '30' HOUR, SYSTIMESTAMP - INTERVAL '30' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (25, 5, '5km 기록 갱신. 다음 목표는 페이스보다 꾸준함. #러닝 #기록', 'A new five kilometer record with consistency as the next goal.', SYSTIMESTAMP - INTERVAL '34' HOUR, SYSTIMESTAMP - INTERVAL '34' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (26, 8, '동네 서점에서 산 책 두 권. 이번 주말은 화면보다 종이에 조금 더 가까이. #책 #기록', 'Two books from a local bookstore.', SYSTIMESTAMP - INTERVAL '38' HOUR, SYSTIMESTAMP - INTERVAL '38' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (27, 9, '집에서 만든 가지 파스타. 접시까지 따뜻한 저녁이었다. #맛집 #일상', 'Homemade eggplant pasta for a warm dinner.', SYSTIMESTAMP - INTERVAL '42' HOUR, SYSTIMESTAMP - INTERVAL '42' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (28, 10, '여행 가방은 작게, 사진은 넉넉하게. 다음 목적지는 아직 비워둔다. #여행 #사진', 'Packing light and leaving the next destination open.', SYSTIMESTAMP - INTERVAL '46' HOUR, SYSTIMESTAMP - INTERVAL '46' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (29, 12, '오늘의 빌드 로그. 서버는 조용히 통과했고 프론트는 작은 간격 하나가 마음에 걸린다. #개발 #DevLife', 'Build log with backend passing and a frontend spacing note.', SYSTIMESTAMP - INTERVAL '50' HOUR, SYSTIMESTAMP - INTERVAL '50' HOUR, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (30, 15, '팔로우 이벤트와 좋아요 이벤트로 작은 굿즈를 드려요. 발표에서는 숨겨진 단어 모드를 켜서 접힘 처리를 보여주세요. #이벤트 #클래스', 'A safe event caption for the hidden words toggle.', SYSTIMESTAMP - INTERVAL '54' HOUR, SYSTIMESTAMP - INTERVAL '54' HOUR, NULL);
COMMIT;

