-- Multi-login Instagram-style demo seed data for Aigram.
-- init.sql remains the comparison baseline; this init.sql2 version keeps the schema/Oracle syntax and expands INSERT data for realistic multi-account demos.

-- RESET EXISTING DEMO DATA
DELETE FROM story_views;
DELETE FROM post_read_logs;
DELETE FROM notifications;
DELETE FROM comments;
DELETE FROM saves;
DELETE FROM likes;
DELETE FROM post_hashtags;
DELETE FROM medias;
DELETE FROM stories;
DELETE FROM follow_requests;
DELETE FROM follows;
DELETE FROM token_blacklist;
DELETE FROM hashtags;
DELETE FROM posts;
DELETE FROM users;
COMMIT;

