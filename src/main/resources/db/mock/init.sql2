-- COMMENTS
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (1, 1, 192, '댓글까지 연결되니까 피드가 훨씬 자연스럽게 느껴집니다.', SYSTIMESTAMP - INTERVAL '36' MINUTE, SYSTIMESTAMP - INTERVAL '35' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (2, 1, 146, '캡션이 구체적이라 계정의 성격이 잘 보여요.', SYSTIMESTAMP - INTERVAL '42' MINUTE, SYSTIMESTAMP - INTERVAL '41' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (3, 1, 124, '다음 화면으로 넘어가는 흐름도 같이 확인해보면 좋겠습니다.', SYSTIMESTAMP - INTERVAL '48' MINUTE, SYSTIMESTAMP - INTERVAL '47' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (4, 1, 23, '다음 화면으로 넘어가는 흐름도 같이 확인해보면 좋겠습니다.', SYSTIMESTAMP - INTERVAL '54' MINUTE, SYSTIMESTAMP - INTERVAL '53' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (5, 1, 94, '프로필에서 들어와도 빈 계정 느낌이 안 납니다.', SYSTIMESTAMP - INTERVAL '60' MINUTE, SYSTIMESTAMP - INTERVAL '59' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (6, 1, 186, '저장해두고 다시 참고하고 싶어요.', SYSTIMESTAMP - INTERVAL '66' MINUTE, SYSTIMESTAMP - INTERVAL '65' MINUTE, NULL);
INSERT INTO comments (comment_id, post_id, user_id, text, created_at, updated_at, deleted_at) VALUES (7, 1, 3, '이 흐름이면 실제 계정처럼 보여서 시연하기 좋겠어요.', SYSTIMESTAMP - INTERVAL '72' MINUTE, SYSTIMESTAMP - INTERVAL '71' MINUTE, NULL);
