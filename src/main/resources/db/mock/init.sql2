-- POSTS
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (1, 1, 'Aigram 발표 전 마지막 점검. 홈 피드, 프로필, 스토리, 알림 흐름이 한 화면에서 자연스럽게 이어지는지 확인 중입니다. #개발 #Aigram #시연 #자바 #React', NULL, SYSTIMESTAMP - INTERVAL '1' HOUR - INTERVAL '37' MINUTE, SYSTIMESTAMP - INTERVAL '53' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
VALUES (2, 1, '오늘은 카페에서 API 응답과 피드 스크롤 체감을 같이 봤다. 작은 버그를 잡는 시간이 제일 길지만 그만큼 결과가 안정적이다. #개발 #Aigram #시연 #팔로우', NULL, SYSTIMESTAMP - INTERVAL '6' HOUR - INTERVAL '20' MINUTE, SYSTIMESTAMP - INTERVAL '5' HOUR - INTERVAL '40' MINUTE, NULL);
INSERT INTO posts (post_id, user_id, caption, translated_caption, created_at, update_at, delete_at)
