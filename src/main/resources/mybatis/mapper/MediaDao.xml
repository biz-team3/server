<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bizteam3.server.post.dao.MediaDao">
    <insert id="insert"
            parameterType="com.bizteam3.server.post.entity.Media"
            useGeneratedKeys="true"
            keyProperty="mediaId">
        INSERT INTO Media (
            postId,
            mediaType,
            mediaUrl,
            sortOrder,
            originalFileName,
            contentType,
            fileSize,
            createdAt
        ) VALUES (
            #{postId},
            #{mediaType},
            #{mediaUrl},
            #{sortOrder},
            #{originalFilename},
            #{contentType},
            #{fileSize},
            SYSTIMESTAMP
        )
    </insert>
</mapper>