<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bizteam3.server.author.dao.AuthorDao">
    <select id="findById" parameterType="int" resultType="com.bizteam3.server.author.entity.Author">
        SELECT
            author_id,
            username,
            display_name,
            profile_image_url,
            has_active_story,
            is_viewer
        FROM authors
        WHERE author_id = #{authorId}
    </select>
</mapper>
