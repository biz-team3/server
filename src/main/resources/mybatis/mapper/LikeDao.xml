<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bizteam3.server.post.dao.LikeDao">

    <insert id="insert"
            parameterType="com.bizteam3.server.post.entity.Like"
            useGeneratedKeys="true"
            keyProperty="likeId"
            keyColumn="like_id">
        INSERT INTO likes (
        user_id,
        post_id,
        created_at
        ) VALUES (
        #{userId},
        #{postId},
        SYSTIMESTAMP
        )
    </insert>

    <select id="isLiked"
            resultType="int">
        SELECT COUNT(*)
        FROM likes
        WHERE user_id = #{userId}
        AND post_id = #{postId}
    </select>

</mapper>